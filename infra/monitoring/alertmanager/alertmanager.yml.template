# Envoi des alertes par e-mail via le SMTP de Resend (domaine wildtransfer.cloud déjà validé).
# Le mot de passe SMTP et le destinataire sont remplis par deploy-monitoring.sh ; le fichier final n'est jamais versionné.
global:
    smtp_smarthost: smtp.resend.com:587
    smtp_from: 'WildTransfer Supervision <alertes@wildtransfer.cloud>'
    smtp_auth_username: resend
    smtp_auth_password: '$SMTP_PASSWORD'
    smtp_require_tls: true

route:
    receiver: email
    group_by: [alertname, env]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h

receivers:
    - name: email
      email_configs:
          - to: '$ALERT_EMAIL'
            send_resolved: true
