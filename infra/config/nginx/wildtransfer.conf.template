# Vhost WildTransfer (${DOMAIN} est remplacé par provision.sh ; certbot ajoute ensuite le bloc HTTPS)
server {
    listen 80;
    server_name ${DOMAIN};
    client_max_body_size 100M;

    # Interface d'administration de base de données jamais exposée
    location /adminer { return 404; }

    location / {
        limit_req zone=wt_req burst=40 nodelay;
        proxy_pass http://127.0.0.1:7007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
